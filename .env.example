# Boş şablon — gerçek değer YOK. Kopyala: cp .env.example .env.local, sonra kendi değerlerini doldur.
# .env.local .gitignore'dadır, commit'e girmez.

# Supabase proje ayarları (Supabase Dashboard → Project Settings → API).
# SUPABASE_URL ve SUPABASE_ANON_KEY frontend'e gönderilir (anon anahtar, RLS açıkken herkese açık olabilir).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# service_role: RLS'yi atlar, TÜM veriye erişir. Yalnızca sunucu fonksiyonlarında kullanılır;
# frontend'e, loga ya da repoya ASLA girmez.
SUPABASE_SERVICE_ROLE_KEY=
